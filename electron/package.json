{
  "name": "citystate-electron",
  "private": true,
  "version": "0.1.0",
  "description": "Same 城邦演武 page as the Tauri shell, copied from ../game at pack time.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.citystate.electron",
    "productName": "城邦演武",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../game",
        "to": "game"
      }
    ],
    "win": {
      "target": ["dir"],
      "signAndEditExecutable": false,
      "icon": "../src-tauri/icons/icon.ico"
    }
  }
}
