{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "城邦演武",
  "version": "0.2.0",
  "identifier": "com.citystate.tauri",
  "build": {
    "frontendDist": "../game"
  },
  "app": {
    "windows": [
      {
        "title": "城邦演武",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}